        "\n",
        "daya = float(input(\"Daya generator (kW): \"))\n",
        "jam = float(input(\"Lama operasi (jam/hari): \"))\n",
        "konsumsi = float(input(\"Konsumsi solar (liter/kWh): \"))\n",
        "harga = float(input(\"Harga solar (Rp/liter): \"))\n",
        "kapasitas = float(input(\"Kapasitas tangki (liter): \"))\n",
        "arus = float(input(\"Arus kabel (A): \"))\n",
        "hambatan = float(input(\"Hambatan kabel (ohm): \"))\n",
        "\n",
        "# 1. Energi per hari\n",
        "energi = daya * jam\n",
        "\n",
        "# 2. Kebutuhan solar dan biaya per hari\n",
        "solar = energi * konsumsi\n",
        "biaya = solar * harga\n",
        "\n",
        "# 3. Jumlah hari penuh dan sisa solar\n",
        "hari = int(kapasitas // solar)\n",
        "sisa = kapasitas % solar\n",
        "\n",
        "# 4. Rugi daya kabel\n",
        "rugi = (arus ** 2) * hambatan\n",
        "\n",
        "# 5. Pemeriksaan rugi daya\n",
        "tinggi = (rugi > 150) and (arus >= 20)\n",
        "\n",
        "print(\"\\nEnergi per hari (kWh):\", energi)\n",
        "print(\"Solar per hari (liter):\", solar)\n",
        "print(\"Biaya solar (Rp):\", biaya)\n",
        "print(\"Tangki cukup (hari):\", hari)\n",
        "print(\"Solar tersisa (liter):\", sisa)\n",
        "print(\"Rugi daya kabel (W):\", rugi)\n",
        "print(\"Rugi tinggi dan arus >= 20 A?:\", tinggi)\n"
